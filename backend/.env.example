PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/festflow
CORS_ORIGIN=http://localhost:5173,https://stage-zero-three.vercel.app
NODE_ENV=development

# Security & JWT Tokens (Must be long, cryptographically random strings in production)
ACCESS_TOKEN_SECRET=change_this_to_a_secure_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change_this_to_another_secure_random_string_at_least_32_chars
REFRESH_TOKEN_EXPIRY=10d

# Demo Mode (Set to true only if you want 1-click demo login in production)
ENABLE_DEMO=false
